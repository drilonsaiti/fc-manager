rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function getUserTeamId() {
      return getUserData().teamId;
    }

    function isManager() {
      return isSignedIn() && getUserRole() in ['owner', 'coach', 'staff'];
    }

    function isOwner() {
      return isSignedIn() && getUserRole() == 'owner';
    }

    // ── Users ──────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isSignedIn();
      // Own doc OR manager creating for a new member
      allow create: if isSignedIn() && (isUser(userId) || isManager());
      allow update: if isSignedIn() && (isUser(userId) || isManager());
      allow delete: if isOwner();
    }

    // ── Teams ──────────────────────────────────────────────────────────────

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner() && getUserTeamId() == teamId;
      allow delete: if isOwner() && getUserTeamId() == teamId;
    }

    // ── Matches ────────────────────────────────────────────────────────────

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isManager() && request.resource.data.teamId == getUserTeamId();
      allow update: if isManager() && resource.data.teamId == getUserTeamId();
      allow delete: if isManager() && resource.data.teamId == getUserTeamId();
    }

    // ── Availabilities ─────────────────────────────────────────────────────

    match /availabilities/{availId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isUser(request.resource.data.userId);
      allow delete: if isManager();
    }

    // ── Lineups ────────────────────────────────────────────────────────────

    match /lineups/{matchId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // ── Trainings ──────────────────────────────────────────────────────────

    match /trainings/{trainingId} {
      allow read: if isSignedIn();
      allow create: if isManager() && request.resource.data.teamId == getUserTeamId();
      allow update, delete: if isManager() && resource.data.teamId == getUserTeamId();
    }

    // ── Training Attendance ────────────────────────────────────────────────

    match /training_attendance/{attendId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isUser(request.resource.data.userId);
      allow delete: if isManager();
    }

    // ── Stats ──────────────────────────────────────────────────────────────

    match /stats/{statId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }
  }
}
