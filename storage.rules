rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function myProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Profile photos: write your own; read yourself or anyone in your team.
    match /players/{userId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
          || myProfile().teamId == firestore.get(/databases/(default)/documents/users/$(userId)).data.teamId);
      allow write: if request.auth != null && request.auth.uid == userId && isImageUnder5MB();
    }

    // Team logos: only managers of that team may change them.
    match /teams/{teamId}/{fileName} {
      allow read: if request.auth != null && myProfile().teamId == teamId;
      allow write: if request.auth != null
        && myProfile().teamId == teamId
        && myProfile().role in ['owner', 'coach', 'staff']
        && isImageUnder5MB();
    }
  }
}
