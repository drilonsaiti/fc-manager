# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only (never prefix with NEXT_PUBLIC_). Used by /api/public/* and /api/keepalive.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Used to hash visitor IPs for rate limiting (raw IPs are never stored).
LINK_HASH_SALT=
